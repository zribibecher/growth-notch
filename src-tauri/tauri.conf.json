{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrowthNotch",
  "version": "0.1.0",
  "identifier": "com.techuntangled.growth-notch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "notch",
        "title": "Growth Notch",
        "create": false,
        "width": 268,
        "height": 34,
        "focus": false,
        "acceptFirstMouse": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: https://yt3.ggpht.com https://yt3.googleusercontent.com https://i.ytimg.com; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.utilities",
    "shortDescription": "Ambient notch dashboard for YouTube creators",
    "longDescription": "Your YouTube numbers in the MacBook notch. Free, local, bring-your-own API key.",
    "copyright": "Copyright (c) 2026 Becher Zribi",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
