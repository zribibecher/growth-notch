# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo
src-tauri/target/
src-tauri/gen/
# Rewritten by tauri-build from the command list in build.rs
src-tauri/permissions/autogenerated/
.venv/
venv/
__pycache__/

# Secrets and credentials. Nothing in this project needs any of these in git.
# The app's own vault is vault.enc plus .vault.key, which *.enc and *.key already cover.
.env
.env.*
.secret
.secret.*
*.secret
*.pem
*.key
*.enc
*.p8
*.p12
*.pfx
*.cer
*.jks
*.keystore
*.mobileprovision
id_rsa*
id_ed25519*
secrets.json
credentials.json
service-account*.json
.npmrc
.netrc

# OS metadata
.DS_Store
._*
Thumbs.db

# Editors and local tooling
.claude/
# Personal notes that stay on this machine
docs/launch/
.idea/
.vscode/
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Leftovers from icon generation
src-tauri/icons/*.tmp
